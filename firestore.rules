rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the Google account email you sign in with to edit the list.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "YOUR_EMAIL@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Everyone can see the gifts and About Me. Only you can change them.
    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /site/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // The shared list of names in each gift's "Who's buying this?" dropdown.
    // Anyone can add a name; only you can remove one.
    match /people/{personId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Anyone can claim an unclaimed gift. A claim can't be overwritten,
    // and only the person who made it (or you) can remove it.
    match /claims/{giftId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && exists(/databases/$(database)/documents/gifts/$(giftId));
      allow delete: if request.auth != null
        && (resource.data.by == request.auth.uid || isOwner());
      allow update: if false;
    }
  }
}
